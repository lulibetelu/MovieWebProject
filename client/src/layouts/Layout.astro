---
import "../assets/app.css";

import SearchNavbar from "../components/base/SearchNavbar.astro";
import { API_URL } from "../data/config.js";

// Props recibidos desde cada página
const { title, searchTerm, movieLen, actorLen } = Astro.props;

// Intentar obtener la sesión del usuario en el servidor (SSR)
// Pasamos la cookie entrante para que el backend identifique la sesión
let user = null;
try {
    const cookieHeader = Astro.request.headers.get("cookie") ?? "";
    const res = await fetch(`${API_URL}/me`, {
        headers: {
            cookie: cookieHeader,
        },
    });
    if (res.ok) {
        const data: any = await res.json();
        if (data && data.authenticated) user = data.user;
    }
} catch (e) {
    // Silencioso: si falla, 'user' queda en null y el navbar mostrará Login
}
---

<!doctype html>
<html lang="en" data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link href="/src/assets/app.css" rel="stylesheet" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>

    <body>
        <SearchNavbar
            searchTerm={searchTerm}
            movie={movieLen}
            actor={actorLen}
            user={user}
        />

        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
