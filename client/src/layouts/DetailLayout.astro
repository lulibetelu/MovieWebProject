---
import "../assets/app.css";

import SimpleNavbar from "../components/base/Navbars/SimpleNavbar.astro";

const { title } = Astro.props;

//const { PUBLIC_API_URL: API_URL } = import.meta.env;

import { API_URL } from "../data/config.js";

// SSR: obtener usuario y exponerlo para uso en el cliente
let user = null;
try {
    const cookieHeader = Astro.request.headers.get("cookie") ?? "";
    const res = await fetch(`${API_URL}/me`, {
        headers: { cookie: cookieHeader },
    });
    if (res.ok) {
        const data = await res.json();
        if (data?.authenticated) {
            user = data.user;
        }
    }
} catch (e) {
    // Ignorar errores de red/SSR, el cliente seguirá mostrando estado no logueado
}
---

<!doctype html>
<html lang="en" data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link href="/src/assets/app.css" rel="stylesheet" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>

    <body>
        <SimpleNavbar searchTerm={title} user={user} />

        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
