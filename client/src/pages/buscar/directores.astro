---
import Layout from "../../layouts/Layout.astro";
import BuscarResultados from "../../components/base/Search/BuscarResultados.astro";

const actual = "directores";

const { PUBLIC_API_URL: API_URL } = import.meta.env;
export const prerender = false;

const searchQuery = Astro.url.searchParams.get("q") || "";
const click = Astro.url.searchParams.get("c") || "0";

if (!searchQuery) return Astro.redirect("/", 302);

let results;
try {
    const res = await fetch(
        `${API_URL}/buscar?q=${encodeURIComponent(searchQuery)}&limit=20`,
    );
    const data = await res.json();
    results = data.searchInfo ?? data;
} catch (e) {
    console.error(e);
}


// Redirección temprana — sin renderizar todavía
// Priority Order
const redirects = [
    {
        condition:
            results.movies.length === 0 &&
            results.directors.length === 0 &&
            results.actors.length === 0,
        redirect: `/buscar/notfound?q=${searchQuery}`,
    },
    {
        condition: results.movies.length > 0,
        redirect: `/buscar/peliculas?q=${searchQuery}`,
    },
    {
        condition: results.actors.length > 0,
        redirect: `/buscar/actores?q=${searchQuery}`,
    },
    { condition: true, redirect: `/buscar/notfound?q=${searchQuery}` },
];

if (results.directors.length === 0 && click === "0") {
    for (const { condition, redirect: p } of redirects) {
        if (condition) {
            return Astro.redirect(p, 307);
        }
    }
}
---

<Layout actual={actual} title={`Resultados para "${searchQuery}"`}>
    <main class="min-h-[calc(100vh-64px)] bg-base-200">
        <section class="max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-10 space-y-8">
            <div
                class="card bg-base-100 border border-primary/20 shadow-md shadow-primary/10"
            >
                <div class="card-body">
                    <h2 class="card-title text-2xl md:text-3xl">
                        Resultados para <span class="text-primary"
                            >"{searchQuery}"</span
                        >
                    </h2>
                </div>
            </div>

            <BuscarResultados
                items={results.directors}
                itemType={actual}
                searchQuery={searchQuery}
            />
        </section>
    </main>
</Layout>
