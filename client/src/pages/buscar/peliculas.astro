---
import Layout from "../../layouts/Layout.astro";
import BuscarResultados from "../../components/base/Search/BuscarResultados.astro";

const actual = "peliculas";

const { PUBLIC_API_URL: API_URL } = import.meta.env;
export const prerender = false;

const searchQuery = Astro.url.searchParams.get("q") || "";
const click = Astro.url.searchParams.get("c") || "0";

if (!searchQuery) return Astro.redirect("/", 302);

let results;

//como pagina es un parametro que cambia con cada paginado, tiene que estar en la url
const page = parseInt(Astro.url.searchParams.get("pagina")) || 1;

try {
    const res = await fetch(
        `${API_URL}/buscar?q=${encodeURIComponent(searchQuery)}&limit=20&pagina=${page}`,
    );
    const data = await res.json();
    results = data.searchInfo ?? data;
} catch (e) {
    console.error(e);
}

// Redirección temprana — sin renderizar todavía
const movies = results?.movies ?? [];
const directors = results?.directors ?? [];
const actors = results?.actors ?? [];

// Priority Order
const redirects = [
    {
        condition:
            movies.length === 0 &&
            directors.length === 0 &&
            actors.length === 0,
        path: `/buscar/notfound?q=${searchQuery}`,
    },
    {
        condition: actors.length > 0,
        path: `/buscar/actores?q=${searchQuery}`,
    },
    {
        condition: directors.length > 0,
        path: `/buscar/directores?q=${searchQuery}`,
    },
    { condition: true, path: `/buscar/notfound?q=${searchQuery}` },
];

if (movies.length === 0 && click == "0") {
    for (const { condition, path } of redirects) {
        if (condition) {
            return Astro.redirect(path, 307);
        }
    }
}
const hasMore = movies.length >= 18;
---

<Layout actual={actual} title={`Resultados para "${searchQuery}"`}>
    <main class="min-h-[calc(100vh-64px)] bg-base-200">
        <section class="max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-10 space-y-8">
            <div
                class="card bg-base-100 border border-primary/20 shadow-md shadow-primary/10"
            >
                <div class="card-body">
                    <h2 class="card-title text-2xl md:text-3xl">
                        Resultados para <span class="text-primary"
                            >"{searchQuery}"</span
                        >
                    </h2>
                </div>
            </div>

            <BuscarResultados
                items={movies}
                itemType={actual}
                searchQuery={searchQuery}
            />

            <div class="join mt-6 flex justify-center">
                {
                    page === 1 ? (
                        <button class="join-item btn">«</button>
                    ) : (
                        <a
                            href={`/buscar/peliculas?q=${encodeURIComponent(searchQuery)}&limit=20&pagina=${page - 1}`}
                            class="join-item btn"
                        >
                            «
                        </a>
                    )
                }
                <button class="join-item btn">Página {page}</button>
                {
                    !hasMore ? (
                        <button class="join-item btn">»</button>
                    ) : (
                        <a
                            href={`/buscar/peliculas?q=${encodeURIComponent(searchQuery)}&limit=20&pagina=${page + 1}`}
                            class="join-item btn"
                        >
                            »
                        </a>
                    )
                }
            </div>
        </section>
    </main>
</Layout>
