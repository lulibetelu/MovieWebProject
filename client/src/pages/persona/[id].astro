---
import { API_URL } from "../../data/config";
import DetailLayout from "../../layouts/DetailLayout.astro";
import PersonImages from "../../components/TMDB_Images/PersonImages.jsx";
import PersonTabs from "../../components/persona/PersonTabs.jsx";

const { id } = Astro.params;
let order = "Popularity";
let offsetAct = 0;
let offsetDir = 0;
let desc = "t";

export const prerender = false;

let personData;

try {
    const res = await fetch(
        `${API_URL}/persona/${id}?offsetAct=${offsetAct}&offsetDir=${offsetDir}&order=${order}&desc=${desc}`,
    );
    if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
    }
    const data: any = await res.json();
    personData = data.personData ?? data;
} catch (err) {
    personData = null;
}

if (!personData) {
    personData = {
        person_id: id,
        person_name: "Persona no encontrada",
        gender: "",
        offsetAct: 0,
        offsetDir: 0,
        order,
        ascOrDesc: "t",
        actedMovies: [],
        directedMovies: [],
        totalActedMovies: 0,
        totalDirectedMovies: 0,
    };
}
---

<DetailLayout title={personData.person_name}>
    <body class="p-6">
        <!-- Navbar -->
        <div class="flex">
            <!-- Persona -->
            <div class="w-1/3 mt-5">
                <div class="card bg-base-100 w-85 shadow-sm">
                    <figure
                        class="relative w-full h-96 bg-base-200 flex items-center justify-center rounded-xl overflow-hidden"
                    >
                        <PersonImages
                            data={{ personName: personData.person_name }}
                            client:load
                        />
                    </figure>
                    <div class="card-body">
                        <h2 class="card-title">{personData.person_name}</h2>
                        <ul>
                            <li>Gender: {personData.gender}</li>
                            <li>Acted Movies: {personData.totalActedMovies}</li>
                            <li>
                                Directed Movies: {
                                    personData.totalDirectedMovies
                                }
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Películas -->
            <div class="w-2/3">
                <PersonTabs
                    client:only="react"
                    personId={personData.person_id}
                    initial={personData}
                />
            </div>
        </div>
    </body>
</DetailLayout>
