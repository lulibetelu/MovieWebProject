---
import DetailLayout from "../../layouts/DetailLayout.astro";
import RecentActivityCarousel from "../../components/reusables/RecentActivityCarousel"

// Esta página debe ejecutarse en el cliente para poder enviar cookies al backend
export const prerender = false;
---

<DetailLayout>
    <main class="min-h-[calc(100vh-64px)] bg-base-200">
        <section class="max-w-3xl mx-auto px-4 md:px-6 py-8 space-y-6">
            <div
                class="card bg-base-100 border border-primary/20 shadow-md shadow-primary/10"
            >
                <div class="card-body">
                    <h1 class="card-title text-2xl md:text-3xl">Perfil</h1>
                    <p class="text-base-content/70">Información de tu cuenta</p>
                </div>
            </div>

            <div
                id="loading"
                class="card bg-base-100 border border-base-300 shadow-sm"
            >
                <div class="card-body">
                    <div class="flex items-center gap-3">
                        <span
                            class="loading loading-spinner loading-md text-primary"
                        ></span>
                        <span>Cargando perfil...</span>
                    </div>
                </div>
            </div>

            <div
                id="error"
                class="card bg-base-100 border border-error/30 shadow-sm hidden"
            >
                <div class="card-body">
                    <div class="alert alert-error">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6 shrink-0 stroke-current"
                            fill="none"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4m0 4h.01"
                            ></path>
                        </svg>
                        <span id="error-text"
                            >No se pudo cargar el perfil. Reintentá más tarde.</span
                        >
                    </div>
                    <div class="card-actions justify-end">
                        <a href="/" class="btn btn-outline">Volver al inicio</a>
                    </div>
                </div>
            </div>

            <div
                id="profile"
                class="card bg-base-100 border border-base-300 shadow-sm hidden"
            >
                <div class="card-body space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <div class="text-sm text-base-content/60">
                                Usuario
                            </div>
                            <div
                                id="profile-username"
                                class="text-lg font-semibold"
                            >
                                -
                            </div>
                        </div>
                        <div>
                            <div class="text-sm text-base-content/60">
                                Email
                            </div>
                            <div id="profile-email" class="text-lg">—</div>
                        </div>
                    </div>

                    <div class="divider"></div>
                    <section class="max-w-3xl mx-auto px-4 md:px-6 py-8 space-y-6">
                        <div id="activity" class="mt-6">
                            <RecentActivityCarousel client:load activities={[]} />
                        </div>
                    </section>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href="/auth/logout" class="btn btn-error"
                            >Cerrar sesión</a
                        >
                        <a href="/" class="btn btn-ghost">Ir al inicio</a>
                    </div>
                </div>
            </div>

            <noscript>
                <div class="alert alert-warning">
                    <span
                        >Necesitás habilitar JavaScript para ver tu perfil.</span
                    >
                </div>
            </noscript>
        </section>
    </main>

    <script>
        // @ts-nocheck
        const API_URL = "http://localhost:3500/api";
        async function loadProfile() {
            const loading = document.getElementById("loading");
            const errorBox = document.getElementById("error");
            const errorText = document.getElementById("error-text");
            const profile = document.getElementById("profile");
            const usernameEl = document.getElementById("profile-username");
            const emailEl = document.getElementById("profile-email");

            try {
                const res = await fetch(`${API_URL}/me`, {
                    method: "GET",
                    credentials: "include",
                });

                const data = await res.json().catch(() => null);

                if (!res.ok || !data || !data.authenticated) {
                    // Si no está autenticado, redirigimos a login
                    const redirectTo = encodeURIComponent(
                        window.location.pathname,
                    );
                    window.location.href = `/auth/login?redirect=${redirectTo}`;
                    return;
                }

                // Mostrar datos
                usernameEl.textContent = data.user?.username || "—";
                emailEl.textContent = data.user?.email || "—";

                loading.classList.add("hidden");
                errorBox.classList.add("hidden");
                profile.classList.remove("hidden");
            } catch (err) {
                console.error(err);
                loading.classList.add("hidden");
                errorBox.classList.remove("hidden");
                errorText.textContent =
                    "Ocurrió un error al obtener tu perfil. Intentá nuevamente.";
            }


        }


        document.addEventListener("DOMContentLoaded", loadProfile);
    </script>
</DetailLayout>
