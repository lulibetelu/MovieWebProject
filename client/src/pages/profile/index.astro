---
import DetailLayout from "../../layouts/DetailLayout.astro";
import RecentActivityCarousel from "../../components/reusables/RecentActivityCarousel";

export const prerender = false;
---

<DetailLayout title="Perfil">
    <main
            class="min-h-[calc(100vh-64px)] bg-gradient-to-br from-black via-[#120200] to-[#1f0a00] text-gray-200"
    >
        <section class="relative max-w-5xl mx-auto py-16 px-6">
            <!-- Efecto de fondo decorativo -->
            <div class="absolute inset-0 overflow-hidden pointer-events-none">
                <div
                        class="absolute w-[700px] h-[700px] bg-orange-500/10 blur-[150px] rounded-full -top-40 -right-40 animate-pulse"
                ></div>
                <div
                        class="absolute w-[500px] h-[500px] bg-red-600/10 blur-[120px] rounded-full bottom-0 -left-32 animate-pulse delay-200"
                ></div>
            </div>

            <!-- Encabezado -->
            <div class="relative text-center mb-14">
                <h1
                        class="text-5xl font-extrabold tracking-tight text-white drop-shadow-[0_0_15px_#ff7b00]"
                >
                    Perfil
                </h1>
                <p class="mt-4 text-gray-400 text-lg max-w-2xl mx-auto">
                    Información de tu cuenta y tu actividad reciente 🍿
                </p>
                <div class="mt-6 flex justify-center">
                    <div
                            class="h-1 w-24 bg-gradient-to-r from-orange-500 to-yellow-400 rounded-full shadow-[0_0_10px_#ff7b00]"
                    ></div>
                </div>
            </div>

            <!-- Contenedor principal -->
            <div
                    class="relative bg-[#0e0703]/60 border border-orange-500/30 rounded-3xl shadow-[0_0_40px_rgba(255,120,0,0.25)] p-8 backdrop-blur-md space-y-8"
            >
                <!-- Estado: cargando -->
                <div
                        id="loading"
                        class="flex justify-center items-center py-20 gap-3 text-orange-300"
                >
                    <span class="loading loading-spinner loading-lg"></span>
                    <span class="text-lg">Cargando perfil...</span>
                </div>

                <!-- Estado: error -->
                <div id="error" class="hidden text-center text-red-400 py-6">
                    <p id="error-text" class="mb-4">
                        No se pudo cargar el perfil. Reintentá más tarde.
                    </p>
                    <a href="/" class="btn btn-outline btn-warning"
                    >Volver al inicio</a
                    >
                </div>

                <!-- Perfil -->
                <div id="profile" class="hidden space-y-8">
                    <!-- Datos del usuario -->
                    <div
                            class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-[#1a0a05]/70 border border-orange-500/20 rounded-2xl p-6 shadow-inner"
                    >
                        <div>
                            <div class="text-sm text-gray-400">Usuario</div>
                            <div
                                    id="profile-username"
                                    class="text-xl font-semibold text-orange-300"
                            >
                                —
                            </div>
                        </div>
                        <div>
                            <div class="text-sm text-gray-400">Email</div>
                            <div
                                    id="profile-email"
                                    class="text-xl font-semibold text-orange-300"
                            >
                                —
                            </div>
                        </div>
                    </div>

                    <!-- Actividad reciente -->
                    <div
                            class="bg-[#1a0a05]/70 border border-orange-500/20 rounded-2xl p-6 shadow-inner"
                    >
                        <h2
                                class="text-2xl font-semibold text-orange-400 mb-6 text-center"
                        >
                            Actividad reciente
                        </h2>
                        <RecentActivityCarousel client:load activities={[]} />
                    </div>

                    <!-- Botones -->
                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <a
                                href="/auth/logout"
                                class="btn bg-red-600 hover:bg-red-700 border-none text-white px-6"
                        >
                            Cerrar sesión
                        </a>
                        <a
                                href="/"
                                class="btn btn-outline border-orange-400 text-orange-400 hover:bg-orange-500/10"
                        >
                            Ir al inicio
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        const API_URL = "http://localhost:3500/api";
        async function loadProfile() {
            const loading = document.getElementById("loading");
            const errorBox = document.getElementById("error");
            const errorText = document.getElementById("error-text");
            const profile = document.getElementById("profile");
            const usernameEl = document.getElementById("profile-username");
            const emailEl = document.getElementById("profile-email");

            try {
                const res = await fetch(`${API_URL}/me`, {
                    credentials: "include",
                });
                const data = await res.json();

                if (!res.ok || !data.authenticated) {
                    const redirectTo = encodeURIComponent(window.location.pathname);
                    window.location.href = `/auth/login?redirect=${redirectTo}`;
                    return;
                }

                usernameEl.textContent = data.user?.username || "—";
                emailEl.textContent = data.user?.email || "—";

                loading.classList.add("hidden");
                errorBox.classList.add("hidden");
                profile.classList.remove("hidden");
            } catch (err) {
                console.error(err);
                loading.classList.add("hidden");
                errorBox.classList.remove("hidden");
                errorText.textContent =
                    "Ocurrió un error al obtener tu perfil. Intentá nuevamente.";
            }
        }

        document.addEventListener("DOMContentLoaded", loadProfile);
    </script>
</DetailLayout>
